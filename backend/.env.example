# Agent Dev Scaffolding - 后端环境变量模板
# 复制此文件为 .env 或在启动命令中传入环境变量

# 数据库配置
DB_URL=jdbc:mysql://localhost:3306/anjing?useUnicode=true&characterEncoding=utf8&serverTimezone=GMT%2B8&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_password_here

# Druid 监控后台
DRUID_USERNAME=admin
DRUID_PASSWORD=admin123

# Redis（如启用）
# REDIS_HOST=localhost
# REDIS_PORT=6379

# MinIO（如启用）
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=your_access_key
# MINIO_SECRET_KEY=your_secret_key
# MINIO_BUCKET=default

# OSS（如启用）
# OSS_ENDPOINT=
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_BUCKET=
